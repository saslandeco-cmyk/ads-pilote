# Google Ads API - à configurer lors de l'intégration réelle
# Depuis le 9/09/2026 le developer token n'est plus requis (sunset Google) ;
# l'accès se gère désormais au niveau du projet Google Cloud (Test/Explorer/Basic/Standard).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_ADS_API_VERSION=v26

# Base de données (Neon / PostgreSQL)
DATABASE_URL=

# Sécurité applicative
AUTH_SECRET=
